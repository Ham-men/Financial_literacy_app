<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка бота для списка жителей / найма (можно использовать в RecyclerView или как референс для Compose) -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/kopilkino_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivBotAvatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_bot_worker"
            android:contentDescription="@string/bot_worker"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvBotType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bot_worker"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/kopilkino_text" />

            <TextView
                android:id="@+id/tvBotSalary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Зарплата: 120 ₡/день"
                android:textSize="13sp"
                android:textColor="@color/kopilkino_text_secondary"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvBotDistrict"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Район: Рынок"
                android:textSize="12sp"
                android:textColor="@color/kopilkino_text_secondary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivMood"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_pet_raccoon_happy"
            android:contentDescription="Настроение" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
