<?xml version="1.0" encoding="utf-8"?>
<!-- Карта Копилкино: 6 районов, дороги, дома, пустые участки.
     Сетка 2×3 совпадает с ic_city_map_kopilkino.xml
     Богатый | Центр
     Рынок   | Спальный
     Промзона| Техно-парк -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_map"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E8F5E9">

    <!-- Шапка -->
    <LinearLayout
        android:id="@+id/header_map"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@color/map_header">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_pet_raccoon"
            android:contentDescription="@string/map_you_are_here" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_title"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_subtitle"
                android:textColor="#BBDEFB"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="8dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_coin_chip">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_coin"
                android:contentDescription="@string/currency_symbol" />

            <TextView
                android:id="@+id/tv_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="500 ₡"
                android:textColor="#4E342E"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Рамка карты + картинка + кликабельные сектора -->
    <FrameLayout
        android:id="@+id/map_board"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:padding="6dp"
        android:background="@drawable/bg_map_frame">

        <ImageView
            android:id="@+id/img_city_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/ic_city_map_kopilkino"
            android:contentDescription="@string/town_name" />

        <!-- Оверлей 2×3: тап по району. Свободные участки подписаны снизу. -->
        <LinearLayout
            android:id="@+id/grid_sectors"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:weightSum="3">

            <!-- Ряд 1: Богатый | Центр -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:weightSum="2">

                <FrameLayout
                    android:id="@+id/sector_rich"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/sector_rich">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_map_badge"
                        android:backgroundTint="#F9A825"
                        android:text="@string/sector_rich"
                        android:textColor="#4E342E"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badge_lot_rich"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_map_badge"
                        android:backgroundTint="@color/map_lot_badge"
                        android:drawableLeft="@drawable/ic_lot_empty"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:text="@string/lot_count_1"
                        android:textColor="@color/map_lot_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/sector_center"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/sector_center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_map_badge"
                        android:backgroundTint="#8E24AA"
                        android:text="@string/sector_center"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badge_lot_center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_map_badge"
                        android:backgroundTint="@color/map_lot_badge"
                        android:drawableLeft="@drawable/ic_lot_empty"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:text="@string/lot_count_1"
                        android:textColor="@color/map_lot_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- Ряд 2: Рынок | Спальный -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:weightSum="2">

                <FrameLayout
                    android:id="@+id/sector_market"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/sector_market">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_map_badge"
                        android:backgroundTint="#FB8C00"
                        android:text="@string/sector_market"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badge_lot_market"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_map_badge"
                        android:backgroundTint="@color/map_lot_badge"
                        android:drawableLeft="@drawable/ic_lot_empty"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:text="@string/lot_count_2"
                        android:textColor="@color/map_lot_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/sector_residential"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/sector_residential">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_map_badge"
                        android:backgroundTint="#43A047"
                        android:text="@string/sector_residential"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badge_lot_residential"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_map_badge"
                        android:backgroundTint="@color/map_lot_badge"
                        android:drawableLeft="@drawable/ic_lot_empty"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:text="@string/lot_count_1"
                        android:textColor="@color/map_lot_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- Ряд 3: Промзона (скромный) | Техно-парк -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:weightSum="2">

                <FrameLayout
                    android:id="@+id/sector_industrial"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/sector_industrial">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_map_badge"
                        android:backgroundTint="#607D8B"
                        android:text="@string/sector_industrial"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badge_lot_industrial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_map_badge"
                        android:backgroundTint="@color/map_lot_badge"
                        android:drawableLeft="@drawable/ic_lot_empty"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:text="@string/lot_count_2"
                        android:textColor="@color/map_lot_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/sector_tech"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/sector_tech">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_map_badge"
                        android:backgroundTint="#0288D1"
                        android:text="@string/sector_tech"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badge_lot_tech"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_map_badge"
                        android:backgroundTint="@color/map_lot_badge"
                        android:drawableLeft="@drawable/ic_lot_empty"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:text="@string/lot_count_3"
                        android:textColor="@color/map_lot_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Легенда -->
    <LinearLayout
        android:id="@+id/legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:background="@color/map_legend_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="#F9E79F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="12dp"
                android:text="@string/map_legend_rich"
                android:textColor="@color/kopilkino_text"
                android:textSize="11sp" />

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="#B0BEC5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="12dp"
                android:text="@string/map_legend_poor"
                android:textColor="@color/kopilkino_text"
                android:textSize="11sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_lot_empty"
                android:contentDescription="@string/lot_for_sale" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="@string/map_legend_lot"
                android:textColor="@color/kopilkino_text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
